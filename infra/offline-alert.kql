AppServiceConsoleLogs
| where TimeGenerated > ago(2d)
| where _ResourceId =~ '__APP_RESOURCE_ID__'
| where ResultDescription has 'dishwasher.connectivity'
| extend connectivity = parse_json(substring(ResultDescription, indexof(ResultDescription, '{')))
| where connectivity.event == 'dishwasher.connectivity'
| extend applianceId = tostring(connectivity.applianceId),
         applianceName = tostring(connectivity.applianceName),
         observedAt = todatetime(connectivity.observedAt),
         offlineSince = tostring(connectivity.offlineSince),
         alertActive = tobool(connectivity.alertActive)
| summarize arg_max(observedAt, *) by applianceId
| where alertActive == true
| project applianceId, applianceName, offlineSince
