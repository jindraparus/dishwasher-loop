HOME_CONNECT_CLIENT_ID=
HOME_CONNECT_CLIENT_SECRET=
HOME_CONNECT_REDIRECT_URI=http://localhost:3000/auth/callback
COOKIE_SECRET=randomly-generated-32-character-string
# Use "local" for a JSON file in .data; use a real connection string in Azure.
AZURE_STORAGE_CONNECTION_STRING=local
AZURE_TABLE_NAME=DishwasherLoop
# Azure enables these automatically; keep auth disabled for local development.
REQUIRE_MICROSOFT_AUTH=false
APP_ALLOWED_EMAIL=jparus@gmail.com
# Comma-separated Entra object IDs. The legacy singular setting is also accepted.
APP_ALLOWED_PRINCIPAL_IDS=
# KEEP-ALIVE is intentionally omitted. Values are comma-separated.
HOME_CONNECT_EVENT_TYPES=STATUS,EVENT,NOTIFY
# Optional exact item keys; leave empty to keep every item in the selected types.
HOME_CONNECT_EVENT_KEYS=
# IANA timezone used for weekly and monthly cycle statistics.
CYCLE_TIMEZONE=Europe/Prague
PORT=3000
