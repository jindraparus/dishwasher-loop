{
  "servers": {
    "dishwasher-loop": {
      "type": "stdio",
      "command": "/usr/bin/env",
      "args": [
        "node",
        "${workspaceFolder}/src/mcp/server.js"
      ],
      "env": {
        "PATH": "${env:PATH}",
        "DISHWASHER_LOOP_BASE_URL": "http://localhost:3000",
        "DISHWASHER_DOCUMENTS_DIR": "${workspaceFolder}/.data/dishwasher-docs"
      }
    }
  }
}
